+++ b/launcher/src/ely.rs
@@ -0,0 +1,330 @@
+//! Ely.by, and any other authlib (Yggdrasil) server: signing in for the account the game then
+//! plays with. authlib-injector does this to the Java game at launch; Horizon is native, so the
+//! launcher signs in itself, keeps the tokens in the OS keychain (never the password) and hands
+//! the access token to the game in its session file. `ely_proxy` points the game's service calls
+//! at the same server while that account plays.
+//!
+//! The API is the one Ely.by documents (docs.ely.by/en/minecraft-auth.html): `/auth/authenticate`,
+//! `/auth/refresh`, `/auth/validate`, and the authlib session endpoints the proxy forwards to.
+//! Every other authlib server answers the same paths; a player gives its address once.
+use crate::account::{store, Account, Accounts, AuthlibSecrets, SecretStore};
+use serde_json::{json, Value};
+use std::time::Duration;
+
+/// Ely.by's authentication server: what the "Ely.by" button uses.
+pub const DEFAULT_SERVER: &str = "https://authserver.ely.by";
+/// The error Ely.by answers when the account has two-factor authentication on: the player enters
+/// the code from their app, and the password goes as `password:code`.
+pub const TWO_FACTOR: &str = "Account protected with two factor auth.";
+/// What the launcher shows instead: where to put the code.
+pub const TWO_FACTOR_HELP: &str = "This account has two-factor authentication: enter the code \
+     from your app in the 2FA field and sign in again.";
+/// What plays without a session when the tokens are gone and can't be renewed.
+pub const SIGN_IN_AGAIN: &str = "This Ely.by account is not signed in any more. Sign in again.";
+
+/// What one sign-in or refresh gives.
+#[derive(Clone)]
+pub struct Session {
+    pub server: String,
+    pub uuid: String,
+    pub name: String,
+    pub access_token: String,
+    pub client_token: String,
+}
+
+impl std::fmt::Debug for Session {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Session")
+            .field("server", &self.server)
+            .field("uuid", &self.uuid)
+            .field("name", &self.name)
+            .field("access_token", &"<hidden>")
+            .field("client_token", &"<hidden>")
+            .finish()
+    }
+}
+
+impl Session {
+    /// The account the launcher keeps and lists (no secrets).
+    pub fn account(&self) -> Account {
+        Account {
+            uuid: self.uuid.clone(),
+            name: self.name.clone(),
+            skin: None,
+            cape: None,
+            authlib: Some(self.server.clone()),
+        }
+    }
+    /// What the keychain keeps for it.
+    pub fn secrets(&self) -> AuthlibSecrets {
+        AuthlibSecrets {
+            access_token: self.access_token.clone(),
+            client_token: self.client_token.clone(),
+        }
+    }
+}
+
+/// The server address as requests use it: no spaces, no trailing slash.
+pub fn server_url(server: &str) -> String {
+    server.trim().trim_end_matches('/').to_owned()
+}
+
+fn agent(url: &str) -> ureq::Agent {
+    crate::proxy::agent(
+        ureq::AgentBuilder::new().timeout(Duration::from_secs(20)),
+        url,
+    )
+    .build()
+}
+
+/// `body` as the JSON of an error answer, if it is one: `error` and `errorMessage`, as authlib's.
+fn error_text(body: &str) -> Option<String> {
+    let v: Value = serde_json::from_str(body).ok()?;
+    let message = v.get("errorMessage").and_then(Value::as_str)?;
+    Some(if message == TWO_FACTOR {
+        // Where to put the code, rather than the server's words.
+        TWO_FACTOR_HELP.to_owned()
+    } else {
+        message.to_owned()
+    })
+}
+
+fn call(server: &str, method: &str, path: &str, body: Option<&Value>) -> Result<Value, String> {
+    let url = format!("{}{path}", server_url(server));
+    let request = match method {
+        "GET" => agent(&url).get(&url),
+        _ => agent(&url)
+            .post(&url)
+            .set("Content-Type", "application/json; charset=utf-8"),
+    };
+    let response = match body {
+        Some(body) => request.send_string(&body.to_string()),
+        None => request.call(),
+    };
+    match response {
+        Ok(response) => {
+            let text = response.into_string().unwrap_or_default();
+            if text.trim().is_empty() {
+                Ok(Value::Null)
+            } else {
+                serde_json::from_str(&text)
+                    .map_err(|_| "The server sent an answer Horizon can't read.".to_owned())
+            }
+        }
+        Err(ureq::Error::Status(status, response)) => {
+            let text = response.into_string().unwrap_or_default();
+            Err(error_text(&text).unwrap_or_else(|| match status {
+                401 | 403 => "Wrong login or password.".to_owned(),
+                _ => format!("The server answered {status}."),
+            }))
+        }
+        Err(ureq::Error::Transport(e)) => {
+            Err(format!("Could not reach {}: {e}", server_url(server)))
+        }
+    }
+}
+
+/// The `selectedProfile` of a sign-in or refresh answer.
+fn profile(v: &Value) -> Result<(String, String), String> {
+    let id = v
+        .pointer("/selectedProfile/id")
+        .and_then(Value::as_str)
+        .ok_or("The server did not name a Minecraft profile.")?;
+    let name = v
+        .pointer("/selectedProfile/name")
+        .and_then(Value::as_str)
+        .ok_or("The server did not name a Minecraft profile.")?;
+    Ok((id.replace('-', "").to_lowercase(), name.to_owned()))
+}
+
+/// A client token: the launcher's own name for this sign-in, kept with the tokens so a refresh
+/// is recognised as the same client. 32 hex digits, as the protocol's clientToken is.
+fn client_token() -> String {
+    let mut bytes = [0u8; 16];
+    let _ = getrandom::fill(&mut bytes);
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// The access token of a sign-in answer, else the client token the server kept.
+fn tokens(v: &Value, sent: &str) -> Result<(String, String), String> {
+    let access = v
+        .get("accessToken")
+        .and_then(Value::as_str)
+        .filter(|t| !t.is_empty())
+        .ok_or("The server did not send an access token.")?;
+    let client = v
+        .get("clientToken")
+        .and_then(Value::as_str)
+        .unwrap_or(sent)
+        .to_owned();
+    Ok((access.to_owned(), client))
+}
+
+/// Sign in with a login (name or e-mail) and a password. `code` is the two-factor code, when the
+/// account has one on; the first try without it says [`TWO_FACTOR`] instead.
+pub fn authenticate(
+    server: &str,
+    username: &str,
+    password: &str,
+    code: Option<&str>,
+) -> Result<Session, String> {
+    let username = username.trim();
+    if username.is_empty() {
+        return Err("An Ely.by login is its name or e-mail.".into());
+    }
+    let password = match code.map(str::trim).filter(|c| !c.is_empty()) {
+        Some(code) => format!("{}:{code}", password.trim()),
+        None => password.to_owned(),
+    };
+    let client = client_token();
+    let v = call(
+        server,
+        "POST",
+        "/auth/authenticate",
+        Some(&json!({
+            "username": username,
+            "password": password,
+            "clientToken": client,
+            "agent": { "name": "Minecraft", "version": 1 },
+            "requestUser": true,
+        })),
+    )?;
+    let (uuid, name) = profile(&v)?;
+    let (access_token, client_token) = tokens(&v, &client)?;
+    Ok(Session {
+        server: server_url(server),
+        uuid,
+        name,
+        access_token,
+        client_token,
+    })
+}
+
+/// A new access token for a pair that still works. Rotating: the old one stops working.
+pub fn refresh(server: &str, access: &str, client: &str) -> Result<Session, String> {
+    let v = call(
+        server,
+        "POST",
+        "/auth/refresh",
+        Some(&json!({
+            "accessToken": access,
+            "clientToken": client,
+            "requestUser": true,
+        })),
+    )?;
+    let (uuid, name) = profile(&v)?;
+    let (access_token, client_token) = tokens(&v, client)?;
+    Ok(Session {
+        server: server_url(server),
+        uuid,
+        name,
+        access_token,
+        client_token,
+    })
+}
+
+/// Whether `access` is still good. A server Horizon can't reach answers yes: no network never
+/// signs a player out.
+pub fn validate(server: &str, access: &str) -> bool {
+    match call(
+        server,
+        "POST",
+        "/auth/validate",
+        Some(&json!({ "accessToken": access })),
+    ) {
+        Ok(_) => true,
+        Err(e) => e.starts_with("Could not reach"),
+    }
+}
+
+/// A fresh session for the account `account` from what the keychain keeps, or why it plays
+/// offline this time: [`SIGN_IN_AGAIN`] when the tokens are gone and a refresh is refused.
+pub fn session(
+    store: &dyn SecretStore,
+    account: &Account,
+    server: &str,
+) -> Result<Session, String> {
+    let Some(secrets) = crate::account::authlib_secrets_in(store, &account.uuid) else {
+        return Err(SIGN_IN_AGAIN.into());
+    };
+    if validate(server, &secrets.access_token) {
+        return Ok(Session {
+            server: server_url(server),
+            uuid: account.uuid.clone(),
+            name: account.name.clone(),
+            access_token: secrets.access_token,
+            client_token: secrets.client_token,
+        });
+    }
+    let renewed = refresh(server, &secrets.access_token, &secrets.client_token)?;
+    crate::account::set_authlib_secrets(store, &account.uuid, &renewed.secrets())?;
+    Ok(renewed)
+}
+
+/// Sign in, keep the account and its tokens, and make it the one that plays.
+pub fn sign_in(
+    server: &str,
+    username: &str,
+    password: &str,
+    code: Option<&str>,
+) -> Result<Account, String> {
+    let session = authenticate(server, username, password, code)?;
+    let account = session.account();
+    let mut accounts = Accounts::load();
+    accounts.add_authlib(store(), account.clone(), &session.secrets())?;
+    accounts.save()?;
+    Ok(account)
+}
+
+/// The server an account plays on, when it is an authlib account.
+pub fn server_of(account: &Account) -> Option<&str> {
+    account.authlib.as_deref()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn server_addresses_lose_their_trailing_slash() {
+        assert_eq!(
+            server_url(" https://authserver.ely.by/ "),
+            "https://authserver.ely.by"
+        );
+    }
+
+    #[test]
+    fn errors_are_the_servers_words() {
+        assert_eq!(
