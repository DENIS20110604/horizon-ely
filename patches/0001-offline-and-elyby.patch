diff --git a/launcher/src/ely_proxy.rs b/launcher/src/ely_proxy.rs
new file mode 100644
index 0000000..97a2094
--- /dev/null
+++ b/launcher/src/ely_proxy.rs
@@ -0,0 +1,234 @@
+//! The loopback services the game reads while an authlib account (Ely.by) plays. authlib-injector
+//! rewrites the Java game's URLs to the authlib server; Horizon is native, so here the launcher
+//! serves the same discovery document itself and forwards the four calls it names to that server.
+//!
+//! Only the game talks to it: `127.0.0.1`, a random port, and a random path prefix only the
+//! game's environment (`HORIZON_API_DISCOVERY`) knows. The token never passes through the
+//! launcher: the game sends its own, as it would to Mojang.
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::sync::Mutex;
+use std::time::Duration;
+
+/// A running proxy: its discovery URL, and the server it forwards to.
+pub struct Proxy {
+    pub discovery: String,
+    server: String,
+}
+
+/// The proxy kept for the launcher's lifetime: a game start reuses it when the server is the same.
+static HELD: Mutex<Option<Proxy>> = Mutex::new(None);
+
+/// The discovery document's URL for the game, starting the proxy when needed.
+pub fn discovery_for(server: &str) -> Result<String, String> {
+    let server = crate::ely::server_url(server);
+    let mut held = HELD.lock().unwrap();
+    if let Some(proxy) = held.as_ref().filter(|p| p.server == server) {
+        return Ok(proxy.discovery.clone());
+    }
+    *held = None;
+    let proxy = Proxy::start(&server)?;
+    let url = proxy.discovery.clone();
+    *held = Some(proxy);
+    Ok(url)
+}
+
+/// A secret path prefix: 16 hex digits, from the OS.
+fn secret() -> String {
+    let mut bytes = [0u8; 8];
+    let _ = getrandom::fill(&mut bytes);
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+impl Proxy {
+    fn start(server: &str) -> Result<Self, String> {
+        let listener = TcpListener::bind("127.0.0.1:0")
+            .map_err(|e| format!("Could not start the Ely.by services: {e}"))?;
+        let port = listener.local_addr().map_err(|e| e.to_string())?.port();
+        let secret = secret();
+        let base = format!("http://127.0.0.1:{port}/{secret}");
+        let proxy = Self {
+            discovery: format!("{base}/minecraft/client"),
+            server: server.to_owned(),
+        };
+        let routes = Routes {
+            base,
+            server: server.to_owned(),
+        };
+        std::thread::spawn(move || {
+            for stream in listener.incoming().flatten() {
+                let routes = routes.clone();
+                std::thread::spawn(move || {
+                    let _ = serve(stream, &routes);
+                });
+            }
+        });
+        Ok(proxy)
+    }
+}
+
+#[derive(Clone)]
+struct Routes {
+    /// `http://127.0.0.1:PORT/SECRET`, the game's side.
+    base: String,
+    /// The authlib server, as the requests go to it.
+    server: String,
+}
+
+fn serve(mut stream: TcpStream, routes: &Routes) -> std::io::Result<()> {
+    stream.set_read_timeout(Some(Duration::from_secs(20)))?;
+    let mut reader = BufReader::new(stream.try_clone()?);
+    let mut line = String::new();
+    if reader.read_line(&mut line)? == 0 {
+        return Ok(());
+    }
+    let mut parts = line.split_whitespace();
+    let method = parts.next().unwrap_or("").to_owned();
+    let path = parts.next().unwrap_or("").to_owned();
+    let mut length = 0usize;
+    loop {
+        let mut header = String::new();
+        if reader.read_line(&mut header)? == 0 {
+            break;
+        }
+        if header.trim().is_empty() {
+            break;
+        }
+        if let Some((name, value)) = header.split_once(':') {
+            if name.eq_ignore_ascii_case("content-length") {
+                length = value.trim().parse().unwrap_or(0);
+            }
+        }
+    }
+    let mut body = vec![0u8; length.min(1 << 20)];
+    if length > 0 {
+        reader.read_exact(&mut body)?;
+    }
+    let (status, answer) = route(routes, &method, &path, &body);
+    let reason = match status {
+        200 => "OK",
+        204 => "No Content",
+        404 => "Not Found",
+        502 => "Bad Gateway",
+        _ => "Error",
+    };
+    let head = format!(
+        "HTTP/1.1 {status} {reason}\r\nContent-Type: application/json; charset=utf-8\r\n\
+         Content-Length: {}\r\nConnection: close\r\n\r\n",
+        answer.len()
+    );
+    stream.write_all(head.as_bytes())?;
+    stream.write_all(answer.as_bytes())?;
+    stream.flush()
+}
+
+/// The answer for one request: the discovery document, or the server's own answer forwarded.
+fn route(routes: &Routes, method: &str, path: &str, body: &[u8]) -> (u16, String) {
+    let Some(rest) = path.strip_prefix(&format!(
+        "/{}/",
+        routes.base.rsplit('/').next().unwrap_or_default()
+    )) else {
+        return (404, r#"{"error":"Not found"}"#.to_owned());
+    };
+    let (endpoint, query) = match rest.split_once('?') {
+        Some((endpoint, query)) => (endpoint, format!("?{query}")),
+        None => (rest, String::new()),
+    };
+    if endpoint == "minecraft/client" {
+        return (200, discovery(&routes.base));
+    }
+    let (url, method) = if endpoint == "join" {
+        (format!("{}/session/join", routes.server), "POST")
+    } else if endpoint == "verify" {
+        (format!("{}/session/hasJoined{query}", routes.server), "GET")
+    } else if let Some(id) = endpoint.strip_prefix("profile/") {
+        (
+            format!("{}/session/profile/{id}{query}", routes.server),
+            "GET",
+        )
+    } else if let Some(name) = endpoint.strip_prefix("profiles/") {
+        (
+            format!("{}/api/users/profiles/minecraft/{name}", routes.server),
+            "GET",
+        )
+    } else {
+        return (404, r#"{"error":"Not found"}"#.to_owned());
+    };
+    match forward(method, &url, (method == "POST").then_some(body)) {
+        Ok((status, text)) => (status, text),
+        Err(e) => (502, format!(r#"{{"error":"{e}"}}"#)),
+    }
+}
+
+/// The Minecraft services discovery document, every endpoint on the proxy.
+fn discovery(base: &str) -> String {
+    format!(
+        r#"{{"discovery":{{
+            "session":{{"endpoints":{{
+                "join":{{"uri":"{base}/join"}},
+                "verify":{{"uri":"{base}/verify"}},
+                "getProfileById":{{"uri":"{base}/profile/{{profileId}}"}}
+            }}}},
+            "profiles":{{"endpoints":{{
+                "getByName":{{"uri":"{base}/profiles/{{name}}"}}
+            }}}},
+            "authentication":{{"endpoints":{{}}}}
+        }}}}"#
+    )
+}
+
+/// One request to the authlib server, through the player's proxy when one is set.
+fn forward(method: &str, url: &str, body: Option<&[u8]>) -> Result<(u16, String), String> {
+    let agent = crate::proxy::agent(
+        ureq::AgentBuilder::new().timeout(Duration::from_secs(20)),
+        url,
+    )
+    .build();
+    let response = match (method, body) {
+        ("POST", Some(body)) => agent
+            .post(url)
+            .set("Content-Type", "application/json; charset=utf-8")
+            .send_bytes(body),
+        _ => agent.get(url).call(),
+    };
+    match response {
+        Ok(response) => {
+            let status = response.status();
+            Ok((status, response.into_string().unwrap_or_default()))
+        }
+        Err(ureq::Error::Status(status, response)) => {
+            Ok((status, response.into_string().unwrap_or_default()))
+        }
+        Err(ureq::Error::Transport(e)) => Err(e.to_string()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_document_names_the_proxy() {
+        let doc = discovery("http://127.0.0.1:9/abc");
+        let v: serde_json::Value = serde_json::from_str(&doc).unwrap();
+        assert_eq!(
+            v.pointer("/discovery/session/endpoints/join/uri")
+                .and_then(|u| u.as_str()),
+            Some("http://127.0.0.1:9/abc/join")
+        );
+        assert_eq!(
+            v.pointer("/discovery/session/endpoints/getProfileById/uri")
+                .and_then(|u| u.as_str()),
+            Some("http://127.0.0.1:9/abc/profile/{profileId}")
+        );
+    }
+
+    #[test]
+    fn a_wrong_prefix_is_not_found() {
+        let routes = Routes {
+            base: "http://127.0.0.1:9/abc".into(),
+            server: "https://authserver.ely.by".into(),
+        };
+        assert_eq!(route(&routes, "GET", "/nope/minecraft/client", b"").0, 404);
+    }
+}
