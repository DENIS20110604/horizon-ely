+        assert_eq!(error_text("not json"), None);
+    }
+
+    #[test]
+    fn the_profile_is_the_selected_one_without_dashes() {
+        let v = json!({"selectedProfile": {"id": "069A79F4-44E9-4726-A5BE-FCA90E38AAF5", "name": "Notch"}});
+        assert_eq!(
+            profile(&v).unwrap(),
+            (
+                String::from("069a79f444e94726a5befca90e38aaf5"),
+                String::from("Notch")
+            )
+        );
+    }
+
+    #[test]
+    fn two_factor_is_its_own_answer() {
+        assert_eq!(
+            error_text(
+                r#"{"error":"ForbiddenOperationException","errorMessage":"Account protected with two factor auth."}"#
