+impl Secrets {
+    /// The game's session file for an authlib account (Ely.by): its access token, no Microsoft
+    /// refresh token, and `owns` false — this says nothing about a Microsoft account.
+    fn from_authlib(token: &str) -> Self {
+        Self {
+            refresh_token: String::new(),
+            minecraft_token: token.to_owned(),
+            minecraft_expires_at: u64::MAX,
+            xuid: None,
+            owns: false,
+        }
+    }
+}
+
+/// What the keychain keeps for an authlib account (Ely.by): the pair its server issued, never
+/// the password. A Microsoft account's secrets are a [`Secrets`], so the two never parse as each
+/// other and `has_owner` looks at Microsoft accounts only.
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+pub struct AuthlibSecrets {
+    pub access_token: String,
+    pub client_token: String,
+}
+impl std::fmt::Debug for AuthlibSecrets {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("AuthlibSecrets(<hidden>)")
+    }
+}
+
+/// The authlib tokens an account keeps in `store`, if it still has them there.
+pub fn authlib_secrets_in(store: &dyn SecretStore, uuid: &str) -> Option<AuthlibSecrets> {
+    store
+        .get(uuid)
+        .ok()
+        .flatten()
+        .and_then(|s| serde_json::from_str(&s).ok())
+}
+
+/// Keep a renewed pair for `uuid`.
+pub fn set_authlib_secrets(
+    store: &dyn SecretStore,
+    uuid: &str,
+    secrets: &AuthlibSecrets,
+) -> Result<(), String> {
+    store.set(
+        uuid,
+        &serde_json::to_string(secrets).map_err(|e| e.to_string())?,
+    )
+}
+
